{
  "name": "job-bot-argentina",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "jobs:scan": "node --env-file-if-exists=.env apps/cli/src/cli.ts",
    "jobs:sync": "node --env-file-if-exists=.env apps/cli/src/sync.ts",
    "test": "npm run test --workspace=@job-bot/cli && npm run test --workspace=@job-bot/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@job-bot/api",
    "build:api": "npm run build --workspace=@job-bot/api",
    "dev:web": "npm run dev --workspace=@job-bot/web",
    "build:web": "npm run build --workspace=@job-bot/web"
  }
}
