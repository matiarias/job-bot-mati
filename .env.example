# Agregar la clave solo en .env
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Opcional. Aumenta el límite de consultas a Himalayas.
HIMALAYAS_API_KEY=

# Opcionales. Si ambas quedan vacías, NestJS usa el catálogo de ejemplo.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca usar en el frontend.
SUPABASE_SECRET_KEY=
JOB_REFRESH_TOKEN=
JOB_BOT_DOCUMENTED_YEARS=
# URL pública de la web, solo para la API desplegada.
WEB_ORIGIN=
